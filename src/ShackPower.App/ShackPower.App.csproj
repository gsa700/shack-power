<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <LangVersion>latest</LangVersion>
    <BuiltInComInteropSupport>true</BuiltInComInteropSupport>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <AvaloniaUseCompiledBindingsByDefault>true</AvaloniaUseCompiledBindingsByDefault>
    <AssemblyName>ShackPower</AssemblyName>
    <Version>0.1.7-beta</Version>
    <Product>Shack Power</Product>
    <Authors>David Erickson (AB0R)</Authors>
    <ApplicationIcon>Assets/app.ico</ApplicationIcon>
    <!-- Release is a TRUE single file: the in-app updater replaces only the exe, so the native
         libs (Skia/HarfBuzz/ANGLE) MUST be bundled into it, not shipped loose. Without
         IncludeNativeLibrariesForSelfExtract the updated exe lands with no native deps and
         crashes on launch. Applies on publish with a RID; ignored by build/run. -->
    <PublishSingleFile>true</PublishSingleFile>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
  </PropertyGroup>

  <ItemGroup>
    <AvaloniaResource Include="Assets/**" />
    <!-- Also embedded plainly: the Linux installer writes this icon to the XDG icon directory for
         the .desktop entry, and the install switch runs before Avalonia is initialised, so the
         Avalonia asset loader isn't available to read it. It is the 256px frame lifted verbatim out
         of app.ico (which stores its frames as PNG); both are generated together by tools/IconGen
         from assets/icon.svg, so regenerate rather than editing either by hand. -->
    <EmbeddedResource Include="Assets/app-icon.png" LogicalName="app-icon.png" />
  </ItemGroup>

  <ItemGroup>
    <!-- Avalonia 12.x. Bump with: dotnet add package Avalonia -->
    <PackageReference Include="Avalonia" Version="12.1.1" />
    <PackageReference Include="Avalonia.Desktop" Version="12.1.1" />
    <PackageReference Include="Avalonia.Themes.Fluent" Version="12.1.1" />
    <PackageReference Include="Avalonia.Fonts.Inter" Version="12.1.1" />
    <!-- No Avalonia.Diagnostics: it has no 12.x release (W2/LP-100A dropped it for the same
         reason). If DevTools is ever wanted, find where 12.x moved it. -->
  </ItemGroup>

  <ItemGroup>
    <!-- WMI for USB-serial chip-serial pinning (Windows-only; guarded at runtime) -->
    <PackageReference Include="System.Management" Version="10.0.10" />
  </ItemGroup>

  <!-- No Tmds.DBus.Protocol pin, deliberately: under Avalonia 12 the framework resolves a patched
       0.94.x transitively via Avalonia.FreeDesktop, so a pin would only hold the version DOWN.
       Full history of the CVE this guards against is in w2-monitor-x's csproj; verify with
       "dotnet list package" plus the vulnerable and include-transitive switches. -->

  <ItemGroup>
    <ProjectReference Include="..\ShackPower.Core\ShackPower.Core.csproj" />
  </ItemGroup>

  <!-- Avalonia 12 pulls SkiaSharp/HarfBuzzSharp builds that ship native .pdb symbols
       (libSkiaSharp ~81 MB, libHarfBuzzSharp ~20 MB). Unlike the natives themselves these are NOT
       bundled into the single file — they land loose beside the exe, which both triples the release
       zips and breaks the "one self-contained exe" the in-app updater relies on, since it copies
       only the exe. Nobody running a release needs them. The managed pdbs are tiny and stay, so
       crash traces from this app's own code still resolve. Ported from the siblings; LP-100A hit
       this first. -->
  <Target Name="TrimNativeSymbols" AfterTargets="ComputeResolvedFilesToPublishList">
    <ItemGroup>
      <ResolvedFileToPublish
        Remove="@(ResolvedFileToPublish)"
        Condition="'%(Extension)' == '.pdb' And $([System.String]::Copy('%(Filename)').StartsWith('lib'))" />
    </ItemGroup>
  </Target>

</Project>
