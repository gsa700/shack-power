<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:ShackPower.App.ViewModels"
        x:Class="ShackPower.App.Views.MainWindow"
        x:DataType="vm:MainWindowViewModel"
        Width="470" SizeToContent="Height" CanResize="False"
        Background="{StaticResource BgBrush}"
        Icon="/Assets/app-icon.png"
        Title="Shack Power">

  <Grid Margin="16,12" RowDefinitions="Auto,Auto,Auto,Auto,Auto">

    <!-- Header -->
    <Grid Grid.Row="0" ColumnDefinitions="*,Auto,Auto" Margin="0,0,0,12">
      <TextBlock Grid.Column="0" Text="{Binding TitleText}" FontSize="18" FontWeight="Bold"
                 Foreground="{StaticResource TextBrush}" VerticalAlignment="Center"/>
      <Ellipse Grid.Column="1" Width="12" Height="12" Fill="{Binding ConnDotBrush}"
               VerticalAlignment="Center" Margin="0,0,10,0"/>
      <Button Grid.Column="2" Content="Setup" Click="OnSetupClick" VerticalAlignment="Center"/>
    </Grid>

    <!-- The three reading cards: white panels with the VictronConnect offset shadow. -->
    <Grid Grid.Row="1" ColumnDefinitions="*,*,*" Opacity="{Binding ReadoutOpacity}">
      <Border Grid.Column="0" Background="{StaticResource PanelBrush}" CornerRadius="8"
              BoxShadow="3 3 6 0 #B31E4E83" Padding="10,10" Margin="0,0,5,0">
        <StackPanel HorizontalAlignment="Center">
          <TextBlock Text="{Binding VoltsText}" FontFamily="Consolas" FontSize="28" FontWeight="Bold"
                     Foreground="{Binding VoltsBrush}" HorizontalAlignment="Center"/>
          <TextBlock Text="VOLTS" FontSize="10" FontWeight="Bold"
                     Foreground="{StaticResource CardDimBrush}" HorizontalAlignment="Center"/>
        </StackPanel>
      </Border>
      <Border Grid.Column="1" Background="{StaticResource PanelBrush}" CornerRadius="8"
              BoxShadow="3 3 6 0 #B31E4E83" Padding="10,10" Margin="0,0,5,0">
        <StackPanel HorizontalAlignment="Center">
          <TextBlock Text="{Binding AmpsText}" FontFamily="Consolas" FontSize="28" FontWeight="Bold"
                     Foreground="{StaticResource CardTextBrush}" HorizontalAlignment="Center"/>
          <TextBlock Text="AMPS" FontSize="10" FontWeight="Bold"
                     Foreground="{StaticResource CardDimBrush}" HorizontalAlignment="Center"/>
        </StackPanel>
      </Border>
      <Border Grid.Column="2" Background="{StaticResource PanelBrush}" CornerRadius="8"
              BoxShadow="3 3 6 0 #B31E4E83" Padding="10,10">
        <StackPanel HorizontalAlignment="Center">
          <TextBlock Text="{Binding WattsText}" FontFamily="Consolas" FontSize="28" FontWeight="Bold"
                     Foreground="{StaticResource CardTextBrush}" HorizontalAlignment="Center"/>
          <TextBlock Text="WATTS" FontSize="10" FontWeight="Bold"
                     Foreground="{StaticResource CardDimBrush}" HorizontalAlignment="Center"/>
        </StackPanel>
      </Border>
    </Grid>

    <!-- Alarm banner: the SmartShunt's own alarm state, decoded. -->
    <Border Grid.Row="2" Background="{StaticResource RedBrush}" CornerRadius="6"
            Padding="8,4" Margin="0,10,0,0" IsVisible="{Binding AlarmVisible}">
      <TextBlock Text="{Binding AlarmText}" FontWeight="Bold"
                 Foreground="{StaticResource TextBrush}" HorizontalAlignment="Center"/>
    </Border>

    <!-- Secondary rows -->
    <StackPanel Grid.Row="3" Margin="0,12,0,0" Opacity="{Binding ReadoutOpacity}">
      <Grid ColumnDefinitions="Auto,*" IsVisible="{Binding Display.ShowExtremes}" Margin="0,0,0,6">
        <TextBlock Grid.Column="0" Text="MIN / MAX VOLTS" Width="150" FontSize="11" FontWeight="Bold"
                   Foreground="{StaticResource DimBrush}" VerticalAlignment="Center"/>
        <TextBlock Grid.Column="1" Text="{Binding MinMaxText}" FontFamily="Consolas" FontSize="15"
                   FontWeight="Bold" Foreground="{StaticResource TextBrush}" HorizontalAlignment="Right"/>
      </Grid>
      <Grid ColumnDefinitions="Auto,*" IsVisible="{Binding Display.ShowEnergy}" Margin="0,0,0,6">
        <TextBlock Grid.Column="0" Text="ENERGY OUT / IN" Width="150" FontSize="11" FontWeight="Bold"
                   Foreground="{StaticResource DimBrush}" VerticalAlignment="Center"/>
        <TextBlock Grid.Column="1" Text="{Binding EnergyText}" FontFamily="Consolas" FontSize="15"
                   FontWeight="Bold" Foreground="{StaticResource TextBrush}" HorizontalAlignment="Right"/>
      </Grid>
      <Grid ColumnDefinitions="Auto,*" IsVisible="{Binding BatteryRowVisible}" Margin="0,0,0,6">
        <TextBlock Grid.Column="0" Text="BATTERY" Width="150" FontSize="11" FontWeight="Bold"
                   Foreground="{StaticResource DimBrush}" VerticalAlignment="Center"/>
        <TextBlock Grid.Column="1" Text="{Binding BatteryText}" FontFamily="Consolas" FontSize="15"
                   FontWeight="Bold" Foreground="{StaticResource TextBrush}" HorizontalAlignment="Right"/>
      </Grid>
      <Grid ColumnDefinitions="Auto,*" IsVisible="{Binding Display.ShowDevice}" Margin="0,0,0,6">
        <TextBlock Grid.Column="0" Text="DEVICE" Width="150" FontSize="11" FontWeight="Bold"
                   Foreground="{StaticResource DimBrush}" VerticalAlignment="Center"/>
        <TextBlock Grid.Column="1" Text="{Binding DeviceText}" FontSize="13"
                   Foreground="{StaticResource DimBrush}" HorizontalAlignment="Right" VerticalAlignment="Center"/>
      </Grid>
    </StackPanel>

    <!-- Status line -->
    <TextBlock Grid.Row="4" Text="{Binding StatusText}" FontSize="12"
               Foreground="{Binding StatusBrush}" Margin="0,4,0,0"/>

  </Grid>
</Window>
