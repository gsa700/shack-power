<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:ShackPower.App.ViewModels"
        xmlns:ctrl="using:ShackPower.App.Controls"
        x:Class="ShackPower.App.Views.ChartWindow"
        x:DataType="vm:ChartViewModel"
        Width="760" Height="540" MinWidth="520" MinHeight="400"
        Background="{StaticResource BgBrush}"
        Icon="/Assets/app-icon.png"
        Title="Shack Power Chart">

  <!-- Round floating zoom buttons (VictronConnect-style FABs). The Fluent hover repaint is
       overridden per state so the circle stays Victron blue instead of flashing gray. -->
  <Window.Styles>
    <Style Selector="Button.zoomfab">
      <Setter Property="Width" Value="44"/>
      <Setter Property="Height" Value="44"/>
      <Setter Property="CornerRadius" Value="22"/>
      <!-- Slightly translucent at rest so the trace stays readable underneath; solid on hover. -->
      <Setter Property="Opacity" Value="0.72"/>
      <Setter Property="Background" Value="{StaticResource BgBrush}"/>
      <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
      <Setter Property="FontSize" Value="20"/>
      <Setter Property="FontWeight" Value="Bold"/>
      <Setter Property="Padding" Value="0"/>
      <Setter Property="HorizontalContentAlignment" Value="Center"/>
      <Setter Property="VerticalContentAlignment" Value="Center"/>
    </Style>
    <Style Selector="Button.zoomfab:pointerover">
      <Setter Property="Opacity" Value="1"/>
    </Style>
    <Style Selector="Button.zoomfab:pointerover /template/ ContentPresenter">
      <Setter Property="Background" Value="{StaticResource TrackBrush}"/>
      <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
      <Setter Property="CornerRadius" Value="22"/>
    </Style>
    <Style Selector="Button.zoomfab:pressed /template/ ContentPresenter">
      <Setter Property="Background" Value="{StaticResource ShadowBrush}"/>
      <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
      <Setter Property="CornerRadius" Value="22"/>
    </Style>
  </Window.Styles>

  <Grid RowDefinitions="Auto,*" Margin="12">

    <!-- Toolbar: day paging on the left, window presets on the right. -->
    <DockPanel Grid.Row="0">
      <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" Spacing="6">
        <ToggleButton Content="Combined" IsChecked="{Binding Combined}"
                      ToolTip.Tip="Overlay two chosen channels on one plot, each on its own scale"/>
        <Button Content="1 h" Command="{Binding Window1HCommand}" Margin="8,0,0,0"/>
        <Button Content="6 h" Command="{Binding Window6HCommand}"/>
        <Button Content="24 h" Command="{Binding Window24HCommand}"/>
      </StackPanel>
      <StackPanel Orientation="Horizontal" Spacing="8">
        <Button Content="◀" Command="{Binding PrevDayCommand}"/>
        <TextBlock Text="{Binding DayText}" FontSize="15" FontWeight="Bold"
                   Foreground="{StaticResource TextBrush}" VerticalAlignment="Center" MinWidth="130"
                   TextAlignment="Center"/>
        <Button Content="▶" Command="{Binding NextDayCommand}"/>
      </StackPanel>
    </DockPanel>

    <!-- The three strips on one white panel (Split view). -->
    <Border Grid.Row="1" Background="{StaticResource PanelBrush}" CornerRadius="8"
            Padding="10" Margin="0,10,0,0" IsVisible="{Binding Split}">
      <Grid RowDefinitions="Auto,*,Auto,*,Auto,*">
        <TextBlock Grid.Row="0" Text="VOLTS" FontSize="11" FontWeight="Bold"
                   Foreground="{StaticResource CardDimBrush}"/>
        <ctrl:StripChartControl x:Name="VoltStrip" Grid.Row="1" Margin="0,2,0,8"
            Samples="{Binding VoltSamples}" WindowStart="{Binding WindowStart}"
            WindowSeconds="{Binding WindowSeconds}" GapSeconds="{Binding GapSeconds}"
            VoltSamples="{Binding VoltSamples}" AmpSamples="{Binding AmpSamples}"
            WattSamples="{Binding WattSamples}"
            LineBrush="{StaticResource BlueBrush}" EnvelopeBrush="#66387DC5"
            GridBrush="#E4EAF0" LabelBrush="{StaticResource CardDimBrush}"/>

        <TextBlock Grid.Row="2" Text="AMPS" FontSize="11" FontWeight="Bold"
                   Foreground="{StaticResource CardDimBrush}"/>
        <ctrl:StripChartControl x:Name="AmpStrip" Grid.Row="3" Margin="0,2,0,8"
            Samples="{Binding AmpSamples}" WindowStart="{Binding WindowStart}"
            WindowSeconds="{Binding WindowSeconds}" GapSeconds="{Binding GapSeconds}"
            VoltSamples="{Binding VoltSamples}" AmpSamples="{Binding AmpSamples}"
            WattSamples="{Binding WattSamples}"
            LineBrush="{StaticResource OrangeDeepBrush}" EnvelopeBrush="#66E87722"
            GridBrush="#E4EAF0" LabelBrush="{StaticResource CardDimBrush}"/>

        <TextBlock Grid.Row="4" Text="WATTS" FontSize="11" FontWeight="Bold"
                   Foreground="{StaticResource CardDimBrush}"/>
        <ctrl:StripChartControl x:Name="WattStrip" Grid.Row="5" Margin="0,2,0,0"
            Samples="{Binding WattSamples}" WindowStart="{Binding WindowStart}"
            WindowSeconds="{Binding WindowSeconds}" GapSeconds="{Binding GapSeconds}"
            VoltSamples="{Binding VoltSamples}" AmpSamples="{Binding AmpSamples}"
            WattSamples="{Binding WattSamples}"
            LineBrush="{StaticResource GreenBrush}" EnvelopeBrush="#662E9E44"
            GridBrush="#E4EAF0" LabelBrush="{StaticResource CardDimBrush}"/>
      </Grid>
    </Border>

    <!-- Combined view: two chosen channels, dual color-matched axes — the VictronConnect
         Trends arrangement, per the reference screenshot. -->
    <Border Grid.Row="1" Background="{StaticResource PanelBrush}" CornerRadius="8"
            Padding="10" Margin="0,10,0,0" IsVisible="{Binding Combined}">
      <Grid RowDefinitions="Auto,*">
        <!-- Channel pickers, bordered in their trace's color like the reference app; the zoom
             pair sits centered between them. -->
        <Grid Grid.Row="0" ColumnDefinitions="Auto,*,Auto" Margin="0,0,0,8">
          <ComboBox Grid.Column="0" ItemsSource="{Binding Channels}"
                    SelectedItem="{Binding PrimaryChannel}" MinWidth="130"
                    BorderBrush="{Binding PrimaryBrush}" BorderThickness="2"
                    Foreground="{Binding PrimaryBrush}"/>
          <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="10"
                      HorizontalAlignment="Center" VerticalAlignment="Center">
            <Button Classes="zoomfab" Content="−" Command="{Binding ZoomOutCommand}"
                    ToolTip.Tip="Zoom out (mouse wheel on the chart works too)"/>
            <Button Classes="zoomfab" Content="+" Command="{Binding ZoomInCommand}"
                    ToolTip.Tip="Zoom in — down to a one-minute window"/>
          </StackPanel>
          <ComboBox Grid.Column="2" ItemsSource="{Binding Channels}"
                    SelectedItem="{Binding SecondaryChannel}" MinWidth="130"
                    BorderBrush="{Binding SecondaryBrush}" BorderThickness="2"
                    Foreground="{Binding SecondaryBrush}"/>
        </Grid>
        <ctrl:OverlayChartControl x:Name="Overlay" Grid.Row="1"
            PrimarySamples="{Binding PrimarySamples}" SecondarySamples="{Binding SecondarySamples}"
            PrimaryBrush="{Binding PrimaryBrush}" SecondaryBrush="{Binding SecondaryBrush}"
            PrimaryUnit="{Binding PrimaryUnit}" SecondaryUnit="{Binding SecondaryUnit}"
            VoltSamples="{Binding VoltSamples}" AmpSamples="{Binding AmpSamples}"
            WattSamples="{Binding WattSamples}"
            WindowStart="{Binding WindowStart}" WindowSeconds="{Binding WindowSeconds}"
            GapSeconds="{Binding GapSeconds}"
            GridBrush="#E4EAF0" LabelBrush="{StaticResource CardDimBrush}"/>
      </Grid>
    </Border>

  </Grid>
</Window>
